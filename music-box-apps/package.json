{
	"name": "music-box-apps",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --bun dev",
		"build": "bun run --bun vite build",
		"start": "bun run ./build/index.js",
		"db:migrate": "bun run ./db/migrate.ts",
		"db:import": "bun run ./import/import.ts --apply",
		"db:import:dry": "bun run ./import/import.ts",
		"test": "bun test",
		"check": "svelte-kit sync && svelte-check",
		"db:admin": "bun run ./db/admin.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.6.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"postgres": "^3.4.0",
		"@phosphor-icons/web": "^2.1.1",
		"@fontsource-variable/plus-jakarta-sans": "^5.1.0"
	}
}
