# One domain, automatic HTTPS. Audio is served here, not by Python:
# a byte-range request for an MP3 should never wake the application up.
{$DOMAIN:localhost} {
	encode zstd gzip

	# the songs, straight from the volume, cached hard and by the edge
	handle_path /media/mp3/* {
		root * /data/mp3
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle_path /media/covers/* {
		root * /data/covers
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle_path /media/video/* {
		root * /data/video
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# the master WAVs are the owner's: only the app may hand them out
	handle /media/audio/* {
		reverse_proxy app:8095
	}

	handle /vendor/* {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy app:8095
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
