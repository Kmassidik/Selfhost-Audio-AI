[Unit]
Description=Music Studio worker (the graphics-card side)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Desktop/selfhostaudioai/apps/backend
EnvironmentFile=/root/Desktop/selfhostaudioai/apps/docker/.env
ExecStart=/root/Desktop/selfhostaudioai/apps/backend/.venv/bin/python worker.py
Restart=always
RestartSec=5
# The worker finishes the song it is making before it exits. Only the worker
# itself is signalled (not the model process it is waiting on), and it is given
# long enough for the slowest model here: MiniMax, at about fourteen minutes.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
