[Unit]
Description=Music Studio app (website and API, no Docker needed)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Desktop/selfhostaudioai/apps/backend
EnvironmentFile=/root/Desktop/selfhostaudioai/apps/docker/.env
ExecStart=/root/Desktop/selfhostaudioai/apps/backend/.venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8095
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
